// cochem_canvas_target: .devcontainer/devcontainer.json
{
    "name": "CoChem-CORE Advanced GPU Runtime",
    "build": {
        "dockerfile": "../docker.dockerfile"
    },
    "runArgs": [
        "--gpus",
        "all",
        "--shm-size=8gb",
        "--cap-add=SYS_PTRACE"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python",
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true
            },
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.vscode-pylance"
            ]
        }
    },
    "forwardPorts": [
        8866,
        8000,
        8888,
        5173
    ],
    "mounts": [
        "source=${localEnv:SystemDrive}/,target=/host_os_root,type=bind,readonly,consistency=cached"
    ],
    "remoteEnv": {
        "COCHEM_HOST_ORCA_HOME": "/host_os_root"
    },
    "portsAttributes": {
        "8866": {
            "label": "CoChem-UNITY Notebook Dashboard",
            "onAutoForward": "notify"
        },
        "8000": {
            "label": "CoChem-UNITY FastAPI Backend",
            "onAutoForward": "notify"
        },
        "5173": {
            "label": "CoChem-DOCK React SPA",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "pip install --upgrade pip && pip install --user -r requirements.txt",
    "remoteUser": "vscode"
}